apiVersion: v1
kind: PersistentVolumeClaim  
metadata:
  name: ebs-dynamic 
spec:
  accessModes:
    - ReadWriteOnce 
  storageClassName: roboshop-ebs #as we give our storage class name roboshop here we are using here 
  resources:
    requests:
      storage: 6Gi #for claiming the storage as we give dynamically 6gi and here PV is not there as its dynamic volume
---
apiVersion: v1
kind: Pod
metadata:
  name: ebs-dynamic
spec:
  containers:
  - name: nginx
    image: nginx
    volumeMounts:
    - name: persistent-storage
      mountPath: /usr/share/nginx/html #we are mounting here the volume to store our nginx data here
  volumes:
  - name: persistent-storage
    persistentVolumeClaim:
      claimName: ebs-dynamic   #we gave our pvc storage here to our pod  